generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  processing
  ready
  error
}

enum MessageRole {
  user
  assistant
}

enum ContradictionType {
  factual
  logical
  temporal
  numerical
}

enum ContradictionSeverity {
  critical
  warning
  info
}

enum ContradictionStatus {
  open
  resolved
  false_positive
}

// No auth in this assignment: a workspace's slug IS its access control. Anyone
// with the URL can open it. That's an intentional demo-grade tradeoff, not an
// oversight — real multi-tenancy would need auth + row-level security on top
// of this same workspaceId scoping.
model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  documents     Document[]
  chunks        Chunk[]
  conversations Conversation[]

  @@map("workspaces")
}

model Document {
  id          String         @id @default(uuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  status      DocumentStatus @default(processing)
  errorReason String?
  // sha256 of the raw uploaded file bytes. Paired with the unique constraint
  // below, this makes re-uploading the same file in the same workspace a
  // no-op instead of re-running the whole parse/chunk/embed pipeline.
  contentHash String?
  metadata    Json           @default("{}")
  uploadedAt  DateTime       @default(now())
  chunks      Chunk[]

  @@unique([workspaceId, contentHash])
  @@index([workspaceId])
  @@map("documents")
}

model Chunk {
  id          String    @id @default(uuid())
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Denormalized on purpose: the hot retrieval path (vector similarity
  // search) needs to filter by workspace and needs the filename for
  // citations on every single chat query. Forcing a join up to `documents`
  // for that on every query is the wrong tradeoff at this access pattern -
  // a few extra bytes per row buys a strictly simpler, faster query.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  filename    String

  content               String
  contextualizedContent String?
  page                  Int?
  section               String?
  chunkIndex            Int
  // embedding vector(n) column is added via raw-SQL migration (see migrations/*_add_pgvector.sql)
  embedding             Unsupported("vector(1024)")?
  createdAt             DateTime @default(now())

  contradictionsAsA Contradiction[] @relation("ChunkA")
  contradictionsAsB Contradiction[] @relation("ChunkB")

  @@index([documentId])
  @@index([workspaceId])
  @@map("chunks")
}

model Conversation {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String?
  createdAt   DateTime  @default(now())
  messages    Message[]

  @@index([workspaceId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  citedChunkIds  String[]     @default([])
  confidence     Float?
  fromCache      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

model Contradiction {
  id             String                @id @default(uuid())
  workspaceId    String
  chunkAId       String
  chunkA         Chunk                 @relation("ChunkA", fields: [chunkAId], references: [id], onDelete: Cascade)
  chunkBId       String
  chunkB         Chunk                 @relation("ChunkB", fields: [chunkBId], references: [id], onDelete: Cascade)
  statementA     String
  statementB     String
  type           ContradictionType
  severity       ContradictionSeverity
  status         ContradictionStatus   @default(open)
  reasoning      String
  reasoningTrace Json                  @default("{}")
  createdAt      DateTime              @default(now())
  resolvedAt     DateTime?

  @@index([status])
  @@index([workspaceId])
  @@map("contradictions")
}

model RequestLog {
  id              String   @id @default(uuid())
  stage           String
  provider        String
  model           String
  tokensIn        Int      @default(0)
  tokensOut       Int      @default(0)
  latencyMs       Int
  estimatedCostUsd Float   @default(0)
  createdAt       DateTime @default(now())

  @@map("request_logs")
}
