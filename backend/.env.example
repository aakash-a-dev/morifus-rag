# Postgres (pgvector)
DATABASE_URL=postgresql://docint:docint@localhost:5432/docint

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Server
PORT=4000
NODE_ENV=development

# --- LLM / Embedding provider selection (pluggable) ---
LLM_PROVIDER=bedrock
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROVIDER=gemini

# --- AWS Bedrock ---
# Region: Mumbai. If Claude is not directly invocable in this region, set
# BEDROCK_LLM_MODEL_ID to a cross-region inference-profile ARN instead of the
# bare model id (AWS Console -> Bedrock -> Cross-region inference profiles).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# --- Feature toggles ---
CONTEXTUAL_ENRICHMENT=false

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=6
RETRIEVAL_CONFIDENCE_THRESHOLD=0.45
CONTRADICTION_SIMILARITY_THRESHOLD=0.55

# --- Rate limiting (token bucket, requests/minute shared across api+worker) ---
# Shared LLM-call budget (chat + contradiction judging + enrichment). Gemini
# free tier caps gemini-3.6-flash at 5 requests/min/project - keep this below
# that so we throttle gracefully instead of bursting into 429s. Raise this
# if you're on Bedrock or a paid Gemini tier with higher quota.
BEDROCK_RATE_LIMIT_PER_MINUTE=4

# --- Query cache ---
CHAT_CACHE_TTL_SECONDS=300

# Uploads
UPLOAD_DIR=./uploads
